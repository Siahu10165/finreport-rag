# 复制本文件为 .env 后填入真实 key。.env 已被 .gitignore 忽略，不会进仓库。
#   cp .env.example .env        (Windows: copy .env.example .env)

# ---------------- DeepSeek：回答模型 ----------------
DEEPSEEK_API_KEY=sk-在这里填你的DeepSeek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
DEEPSEEK_MODEL=deepseek-flash

# ---------------- 硅基流动：向量模型 ----------------
# 申请地址：https://cloud.siliconflow.cn/account/ak
# 接口文档：https://api-docs.siliconflow.cn/docs/api/embeddings-post
SILICONFLOW_API_KEY=sk-在这里填你的硅基流动-key

EMBED_BASE_URL=https://api.siliconflow.cn/v1
# 8B 模型，MTEB 多语言榜首，检索质量明显优于 0.6B
EMBED_API_MODEL=Qwen/Qwen3-Embedding-8B

# 输出维度。8B 支持 64/128/256/512/768/1024/1536/2048/2560/4096。
# 1024 维：索引 34MB、查询内积快、API 响应体小，质量损失很小。
# 想追极致质量可改 4096，代价是索引 134MB 且查询慢 4 倍。
# 改这个值必须重建索引（retriever 会检测到维度不一致并直接报错提示）。
EMBED_DIM=1024

# 每批文本条数。实测 16~32 条最稳：一次塞太多容易 400 或撞 TPM 限流。
EMBED_API_BATCH=16
# 两次请求最小间隔（秒），自我限速，减少无谓的 429
EMBED_API_INTERVAL=0.15
# 单批最大重试次数（429/5xx 走指数退避重试）
EMBED_API_MAX_RETRIES=6
# 超长文本截断方向：留空=不截断 / right / left。
# 模型支持 32K，财报块 800 字远不到，正常留空即可。
EMBED_API_TRUNCATE=

# ---------------- 切块参数 ----------------
# 对照课件「半年报库的切块」：800 字一块、重合 120 字
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------------- 检索参数 ----------------
VECTOR_TOPK=20
BM25_TOPK=20
RRF_K=60
FINAL_TOPK=8